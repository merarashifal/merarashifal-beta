     */
    public static function render_shadbala_bars_svg($w = 540, $h = 94) {
        $svg = "<svg width='100%' height='{$h}' viewBox='0 0 {$w} {$h}' xmlns='http://www.w3.org/2000/svg' style='background:#FFFFFF; border-radius:8px; border:1px solid #ECE6DD; box-shadow:0 2px 8px rgba(0,0,0,0.02);'>";
        
        $bars = [
            ['name' => 'Karma (Career)',  'score' => 78, 'color' => '#C45738'],
            ['name' => 'Dhana (Wealth)',  'score' => 68, 'color' => '#4E7D68'],
            ['name' => 'Bhagya (Luck)',   'score' => 84, 'color' => '#C2964C'],
            ['name' => 'Labha (Income)',  'score' => 72, 'color' => '#8E7C68'],
            ['name' => 'Prana (Health)',  'score' => 86, 'color' => '#B85A3C']
        ];

        $bar_w = 68;
        $spacing = 100;
        $start_x = 32;

        foreach ($bars as $i => $b) {
            $x = $start_x + ($i * $spacing);
            $bar_h = ($b['score'] / 100) * 48;
            $y = 66 - $bar_h;

            // Background track
            $svg .= "<rect x='{$x}' y='18' width='{$bar_w}' height='48' rx='4' fill='#F4EFE6'/>";
            // Active bar
            $svg .= "<rect x='{$x}' y='{$y}' width='{$bar_w}' height='{$bar_h}' rx='4' fill='{$b['color']}'/>";
            $svg .= "<text x='" . ($x + $bar_w/2) . "' y='" . ($y - 4) . "' fill='#111827' font-size='10.5' font-weight='800' font-family='sans-serif' text-anchor='middle'>{$b['score']}%</text>";
            $svg .= "<text x='" . ($x + $bar_w/2) . "' y='81' fill='#4B5563' font-size='9' font-weight='700' font-family='sans-serif' text-anchor='middle'>{$b['name']}</text>";
        }

        $svg .= "</svg>";
        return $svg;
    }

    /**
     * Render Panchamahabhuta Radar/Pentagon Diagram in SVG (Warm Editorial Edition)
     */
    public static function render_panchamahabhuta_radar_svg($size = 155) {
        $s = $size;
        $cx = $s / 2;
        $cy = $s / 2;
        $r = $s * 0.38;

        $svg = "<svg width='{$s}' height='{$s}' viewBox='0 0 {$s} {$s}' xmlns='http://www.w3.org/2000/svg' style='background:#FFFFFF; border-radius:8px; border:1px solid #ECE6DD; box-shadow:0 2px 8px rgba(0,0,0,0.02);'>";
        
        $elements = [
            ['name' => 'Agni (Fire)',     'pct' => 0.88, 'angle' => -90],
            ['name' => 'Prithvi (Earth)', 'pct' => 0.65, 'angle' => -18],
            ['name' => 'Vayu (Air)',       'pct' => 0.78, 'angle' => 54],
            ['name' => 'Jala (Water)',     'pct' => 0.60, 'angle' => 126],
            ['name' => 'Akash (Space)',   'pct' => 0.82, 'angle' => 198]
        ];

        // Background Web rings
        foreach ([0.33, 0.66, 1.0] as $scale) {
            $pts = [];
            foreach ($elements as $el) {
                $rad = deg2rad($el['angle']);
                $x = $cx + ($r * $scale * cos($rad));
                $y = $cy + ($r * $scale * sin($rad));
                $pts[] = "{$x},{$y}";
            }
            $svg .= "<polygon points='" . implode(' ', $pts) . "' fill='none' stroke='#ECE6DD' stroke-width='1'/>";
        }

        // Active Data Polygon
        $data_pts = [];
        foreach ($elements as $el) {
            $rad = deg2rad($el['angle']);
            $x = $cx + ($r * $el['pct'] * cos($rad));
            $y = $cy + ($r * $el['pct'] * sin($rad));
            $data_pts[] = "{$x},{$y}";
        }

        $svg .= "<polygon points='" . implode(' ', $data_pts) . "' fill='rgba(196,87,56,0.18)' stroke='#C45738' stroke-width='2'/>";

        // Labels
        foreach ($elements as $el) {
            $rad = deg2rad($el['angle']);
            $lx = $cx + (($r + 13) * cos($rad));
            $ly = $cy + (($r + 13) * sin($rad));
            $svg .= "<text x='{$lx}' y='{$ly}' fill='#111827' font-size='8' font-weight='800' font-family='sans-serif' text-anchor='middle' dominant-baseline='central'>{$el['name']}</text>";
        }

        $svg .= "</svg>";
        return $svg;
    }

